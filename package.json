{
  "name": "video-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio",
    "render:scene1": "remotion render Scene1-SoilOf1320 out/scene1-soil-of-1320.mp4",
    "render:scene1:720p": "remotion render Scene1-SoilOf1320-720p out/scene1-soil-of-1320-720p.mp4",
    "still:scene1": "remotion still Scene1-SoilOf1320 out/scene1-frame300.png --frame=300",
    "render:scene2": "remotion render Scene2-ThreePromises out/scene2-three-promises.mp4",
    "render:scene2:720p": "remotion render Scene2-ThreePromises-720p out/scene2-three-promises-720p.mp4",
    "render:film": "remotion render Documentary out/the-dust-of-the-furrow.mp4",
    "render:film:720p": "remotion render Documentary-720p out/the-dust-of-the-furrow-720p.mp4",
    "render": "remotion render Main out/video.mp4",
    "still": "remotion still Main out/thumbnail.png --frame=60",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@remotion/captions": "^4.0.542",
    "@remotion/cli": "^4.0.542",
    "@remotion/media": "^4.0.542",
    "@remotion/media-utils": "^4.0.542",
    "@remotion/three": "^4.0.542",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.542",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
